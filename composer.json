{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.0",
        "ext-redis": "^5.3",
        "eveseat/eseye": "^2.4",
        "guzzlehttp/guzzle": "^7.2",
        "khill/lavacharts": "^3.1.14",
        "laravel/framework": "^9.52",
        "laravel/helpers": "^1.5",
        "laravel/horizon": "^5.8",
        "laravel/socialite": "^5.3",
        "laravel/ui": "^3.3",
        "laravelcollective/html": "^6.3",
        "socialiteproviders/manager": "^4.1",
        "spatie/laravel-rate-limited-job-middleware": "^2.2",
        "spatie/laravel-schedule-monitor": "^3.0",
        "twbs/bootstrap": "^4.5",
        "web-token/jwt-easy": "^2.2",
        "web-token/jwt-signature-algorithm-ecdsa": "^2.2",
        "web-token/jwt-signature-algorithm-hmac": "^2.2",
        "web-token/jwt-signature-algorithm-rsa": "^2.2",
        "league/flysystem-aws-s3-v3": "^3.0",
        "laravel/tinker": "^2.7"
    },
    "require-dev": {
        "beyondcode/laravel-dump-server": "^1.8",
        "filp/whoops": "^2.8",
        "mockery/mockery": "^1.4.4",
        "phpunit/phpunit": "^9.5.10",
        "nunomaduro/collision": "^6.3",
        "fakerphp/faker": "^1.9.1",
        "spatie/laravel-ignition": "^1.4"
    },
    "autoload": {
        "classmap": [
            "database/seeds",
            "database/factories"
        ],
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
